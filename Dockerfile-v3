# =============================================================================
# Defects4J 3.* (Java 11) — self-contained, ready-to-work image.
#
# Build with the repository root as build context (so resources/ is reachable):
#   docker build -f Dockerfile-v3 -t defects4j:3.0.0 --build-arg D4J_VERSION=3.0.0 .
# =============================================================================
FROM ubuntu:26.04
LABEL org.opencontainers.image.source=https://github.com/lukas-png/defects4j-docker
LABEL org.opencontainers.image.licenses=MIT

# -----------------------------------------------------------------------------
# System dependencies + Java 11
# -----------------------------------------------------------------------------
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        perl cpanminus build-essential libcrypt-dev git subversion unzip \
        openjdk-11-jdk \
    && rm -rf /var/lib/apt/lists/*
RUN git config --system --add safe.directory '*'
ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
ENV PATH=${JAVA_HOME}/bin:${PATH}


# -----------------------------------------------------------------------------
# Perl dependencies
# -----------------------------------------------------------------------------
RUN cpanm --notest DBI DBD::CSV URI JSON JSON::Parse List::Util Perl::Critic String::Interpolate \
    || { echo "--- CPANM BUILD LOG ---"; cat /root/.cpanm/work/*/build.log; exit 1; }


# -----------------------------------------------------------------------------
# Defects4J
# -----------------------------------------------------------------------------
ARG D4J_VERSION=3.0.0
ADD https://github.com/rjust/defects4j/archive/refs/tags/v${D4J_VERSION}.tar.gz /tmp/
RUN tar -xzf /tmp/v${D4J_VERSION}.tar.gz -C /opt && \
    mv /opt/defects4j-${D4J_VERSION} /opt/defects4j && \
    rm /tmp/v${D4J_VERSION}.tar.gz
RUN printf '%s\n' "$D4J_VERSION" > /opt/defects4j/version


# -----------------------------------------------------------------------------
# Defects4J initialization
# -----------------------------------------------------------------------------
# simulate init.sh
COPY resources/defects4j-repos-v3.zip /tmp/
RUN unzip -q /tmp/defects4j-repos-v3.zip -d /opt && \
    rm /tmp/defects4j-repos-v3.zip

COPY resources/major-3.0.1_jre11.zip /tmp/
RUN unzip -q /tmp/major-3.0.1_jre11.zip -d /opt/defects4j && \
    sed -i \
        '/CodeCacheSize/a\    -Djava.awt.headless=true \\' \
        /opt/defects4j/major/bin/ant && \
    rm /tmp/major-3.0.1_jre11.zip

RUN mkdir -p /opt/defects4j/framework/lib/build_systems/gradle/dists
COPY resources/defects4j-gradle-dists-v3.zip /tmp/
COPY resources/defects4j-gradle-deps-v3.zip  /tmp/
RUN unzip -q /tmp/defects4j-gradle-dists-v3.zip -d /opt/defects4j/framework/lib/build_systems/gradle/dists && \
    unzip -q /tmp/defects4j-gradle-deps-v3.zip -d /opt/defects4j/framework/lib/build_systems/gradle && \
    rm /tmp/defects4j-gradle-dists-v3.zip /tmp/defects4j-gradle-deps-v3.zip


###############################################################################
# CONTAINER FIXES — patches to upstream Defects4J needed to run inside Docker.
# These do NOT exist upstream; everything outside this block is stock setup.
###############################################################################

# FIX: Defects4J creates per-bug working copies with `git clone`, which uses
#      hardlinks by default and fails across Docker's overlay layers.
RUN sed -i \
        's|git clone $self->{repo}|git clone --no-hardlinks $self->{repo}|' \
        /opt/defects4j/framework/core/Vcs/Git.pm

# FIX: Don't check for test generation tool existence; not needed for base
# Defects4J functionality
RUN sed -i \
        '/-d "\$TESTGEN_LIB_DIR"/{N;d;}' \
        /opt/defects4j/framework/core/Constants.pm

# FIX: Chart project file is missing an entry for Chart-26
RUN FILE=/opt/defects4j/framework/projects/Chart/dir-layout.csv && \
    if [ -f "$FILE" ] && ! grep -Fxq '102,source,tree' "$FILE"; then \
        echo '102,source,tree' >> "$FILE"; \
    fi

###############################################################################
# END CONTAINER FIXES
###############################################################################


# -----------------------------------------------------------------------------
# Helper scripts
# -----------------------------------------------------------------------------
COPY resources/d4j-list-v2      /usr/local/bin/d4j-list
COPY resources/d4j-checkout     /usr/local/bin/d4j-checkout
COPY resources/d4j-checkout-all /usr/local/bin/d4j-checkout-all
RUN chmod +x /usr/local/bin/d4j-checkout \
             /usr/local/bin/d4j-list \
             /usr/local/bin/d4j-checkout-all


# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENV D4J_HOME=/opt/defects4j
ENV PATH=/opt/defects4j/framework/bin:${PATH}
ENV TZ=America/Los_Angeles
ENV _JAVA_OPTIONS=-Dfile.encoding=UTF-8


# -----------------------------------------------------------------------------
# User setup
# -----------------------------------------------------------------------------
RUN useradd -m user && mkdir /work && chown user /work
USER user
WORKDIR /work
CMD ["bash"]
